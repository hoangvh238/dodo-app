# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret key the Electron app must send in X-Analytics-Key header
ANALYTICS_API_KEY=change-this-to-a-random-secret

# Used to protect the dashboard login (Supabase Auth email)
# Only users added in Supabase Auth Dashboard can access
